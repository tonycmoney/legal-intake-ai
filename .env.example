# Copy to backend/.env for local development.

# Required for the intake chat. Without it the chat endpoint returns 503.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low

# Required for the staff dashboard. Without it staff endpoints return 503.
STAFF_PASSWORD=

# SQLite locally; Postgres in production
DATABASE_URL=sqlite:///./intake.db

FIRM_NAME=Hudson Row Legal
FIRM_PHONE=(555) 010-0199
MAX_MESSAGE_CHARS=2000
MAX_TURNS_PER_SESSION=30
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_S=600
DECLINED_RETENTION_DAYS=30
